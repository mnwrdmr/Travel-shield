# ─────────────────────────────────────────────────────────────
# backend/.env.example
# Bu dosyayı .env olarak kopyalayın ve API anahtarlarınızı girin.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Google Gemini API (ücretsiz, önerilen)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=buraya_gemini_api_key_yazin

# OpenAI API (opsiyonel, Gemini fallback'i için)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=buraya_openai_api_key_yazin

# Frontend URL (CORS için)
FRONTEND_URL=http://localhost:3000
